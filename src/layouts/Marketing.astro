---
import '../styles/marketing.css';
import { repo, site } from '../data/project';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
	{ href: '/docs/', label: 'Docs' },
	{ href: '/docs/api/', label: 'API' },
	{ href: '/docs/agents/mcp/', label: 'MCP' },
	{ href: '/docs/project/roadmap/', label: 'Roadmap' },
];
const footer = [
	{
		title: 'Product',
		links: [
			['Quickstart', '/docs/quickstart/'],
			['Import mailboxes', '/docs/guides/import-mailboxes/'],
			['Sequences', '/docs/guides/sequences/'],
			['Warm-up', '/docs/guides/warmup/'],
			['Roadmap', '/docs/project/roadmap/'],
		],
	},
	{
		title: 'Developers',
		links: [
			['API reference', '/docs/api/reference/'],
			['TypeScript SDK', '/docs/sdk/typescript/'],
			['MCP server', '/docs/agents/mcp/'],
			['Self-hosting', '/docs/self-hosting/docker-compose/'],
			['llms.txt', '/llms.txt'],
		],
	},
	{
		title: 'Project',
		links: [
			['GitHub', repo.url],
			['Contact', `mailto:${site.email}`],
			['Issues', repo.issues],
			['Usage stats', '/stats/'],
			['Licensing', '/docs/project/license/'],
			['Contributing', '/docs/project/contributing/'],
			['Security', '/docs/project/security/'],
		],
	},
];
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/og.png', Astro.site)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="color-scheme" content="dark light" />
		<script is:inline>
			// Dark by default, like the app and the docs. Shares the docs' saved choice.
			try { document.documentElement.dataset.theme = localStorage.getItem('starlight-theme') === 'light' ? 'light' : 'dark'; } catch {}
		</script>
	</head>
	<body class="min-h-dvh">
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground">Skip to content</a>
		<header class="sticky top-0 z-40 border-b border-border/60 bg-background/75 backdrop-blur-lg supports-[backdrop-filter]:bg-background/60">
			<div class="mx-auto flex h-14 max-w-6xl items-center gap-6 border-border/70 px-4 sm:px-6 lg:border-x">
				<a href="/" class="touch flex items-center gap-2 text-[15px] font-semibold tracking-tight" aria-label="Outflare home">
					<span aria-hidden="true" class="flex size-6 items-center justify-center rounded-md bg-neutral-900 font-mono text-[11px] font-bold text-white dark:bg-white dark:text-neutral-950">&gt;_</span>
					Outflare
					<span class="badge badge-muted hidden sm:inline-flex">alpha</span>
				</a>
				<nav class="hidden items-center gap-1 md:flex" aria-label="Main">
					{nav.map((l) => <a href={l.href} class="rounded-md px-2.5 py-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground">{l.label}</a>)}
				</nav>
				<div class="ml-auto flex items-center gap-2">
					<button type="button" data-theme-toggle class="btn btn-ghost btn-sm btn-icon size-8 px-0" aria-label="Switch theme" title="Switch theme">
						<svg class="hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
						<svg class="dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
					</button>
					<a href={repo.url} class="btn btn-outline btn-sm hidden sm:inline-flex">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
						GitHub
					</a>
					<a href="/docs/quickstart/" class="btn btn-primary btn-sm">Get started</a>
				</div>
			</div>
			<nav class="flex gap-1 overflow-x-auto border-t border-border/60 px-2 md:hidden" aria-label="Main">
				{nav.map((l) => <a href={l.href} class="touch inline-flex shrink-0 items-center rounded-md px-2.5 text-sm text-muted-foreground hover:text-foreground">{l.label}</a>)}
				<a href={repo.url} class="touch inline-flex shrink-0 items-center rounded-md px-2.5 text-sm text-muted-foreground hover:text-foreground">GitHub</a>
			</nav>
		</header>

		<main id="main" class="relative">
			<!-- Guide rails at the content edges, as on most developer-tool sites. -->
			<div class="pointer-events-none absolute inset-y-0 left-1/2 z-10 hidden w-full max-w-6xl -translate-x-1/2 border-x border-border/70 lg:block" aria-hidden="true"></div>
			<slot />
		</main>

		<footer class="border-t">
			<div class="mx-auto grid max-w-6xl gap-10 border-border/70 px-4 py-14 max-md:grid-cols-2 sm:px-6 md:grid-cols-[1.4fr_repeat(3,1fr)] lg:border-x">
				<div class="max-md:col-span-2">
					<a href="/" class="touch inline-flex items-center gap-2 font-semibold tracking-tight">
						<span aria-hidden="true" class="flex size-6 items-center justify-center rounded-md bg-neutral-900 font-mono text-[11px] font-bold text-white dark:bg-white dark:text-neutral-950">&gt;_</span>
						Outflare
					</a>
					<p class="mt-3 max-w-xs text-sm text-muted-foreground">Open-source cold email infrastructure for people and their agents.</p>
				</div>
				{
					footer.map((col) => (
						<div>
							<h2 class="eyebrow">{col.title}</h2>
							<ul class="mt-4 space-y-2.5 text-sm max-sm:mt-2 max-sm:space-y-0">
								{col.links.map(([label, href]) => (
									<li><a href={href} class="touch inline-flex items-center text-muted-foreground transition-colors hover:text-foreground">{label}</a></li>
								))}
							</ul>
						</div>
					))
				}
			</div>
			<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 border-t px-4 py-6 text-xs text-muted-foreground sm:px-6 lg:border-x lg:border-x-border/70">
				<span>Core licensed AGPL-3.0. SDK and this site licensed Apache-2.0.</span>
				<span class="flex flex-wrap gap-x-4"><a href={`mailto:${site.email}`} class="touch inline-flex items-center hover:text-foreground">{site.email}</a><a href={repo.url} class="touch inline-flex items-center hover:text-foreground">github.com/{repo.owner}/{repo.name}</a></span>
			</div>
		</footer>

		<script>
			document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) =>
				b.addEventListener('click', () => {
					const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
					document.documentElement.dataset.theme = next;
					try { localStorage.setItem('starlight-theme', next); } catch {}
				}),
			);
		</script>
	</body>
</html>
