---
// The blog: posts from the team about why Outflare works the way it does.
import Marketing from '../../layouts/Marketing.astro';
import { posts } from '../../data/blog';

const date = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Marketing
	title="Outflare blog"
	description="Posts from the Outflare team: why we built it, how it fits together, and what it changes for the teams that use it."
	crumbs={[{ name: 'Blog', path: '/blog/' }]}
>
	<section class="relative border-b">
		<div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
			<p class="eyebrow">Blog</p>
			<h1 class="mt-3 max-w-4xl text-4xl font-semibold tracking-tighter text-balance sm:text-5xl">Notes from the team building Outflare.</h1>
		</div>
	</section>
	<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
		<ul class="grid gap-4 sm:grid-cols-2">
			{posts.map((p) => (
				<li class="card p-6">
					<p class="text-sm text-muted-foreground">{date(p.published)} · {p.minutes} minute read</p>
					<h2 class="mt-2 text-xl font-semibold tracking-tight"><a href={`/blog/${p.slug}/`} class="hover:underline">{p.title}</a></h2>
					<p class="mt-2 text-sm text-muted-foreground">{p.description}</p>
				</li>
			))}
		</ul>
	</div>
</Marketing>
