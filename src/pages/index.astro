---
import Marketing from '../layouts/Marketing.astro';
import { milestones, statusLabel, repo, site } from '../data/project';

const shipped = milestones.filter((m) => m.status === 'shipped').length;
const v1 = milestones.filter((m) => m.step !== null).length;

// Real screenshots of the web app (outflare web/), taken with demo data.
const shots = [
	{ id: 'overview', label: 'Overview', alt: 'Overview: sends in the last day and week, reply and bounce rates, mailbox health and outreach totals' },
	{ id: 'inbox-item', label: 'Inbox', alt: 'Inbox: replies from every mailbox, with one conversation open and a reply box sending from the same mailbox' },
	{ id: 'sequences-item', label: 'Sequences', alt: 'A sequence: leads being emailed, sends, replies and opt-outs, and its steps with template variables' },
	{ id: 'mailboxes', label: 'Mailboxes', alt: 'Mailboxes: 18 inboxes with status, warm-up inbox placement, daily warm-up volume and daily limits' },
	{ id: 'domains', label: 'Domains', alt: 'Domains: each sending domain with health, SPF, DKIM and DMARC, active mailboxes, sends, bounces, replies and inbox placement' },
];

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Tiny highlighter for the hand-written snippets below: //, # comments,
// quoted strings and a few keywords.
const hl = (src: string) =>
	esc(src)
		.split('\n')
		.map((line) => {
			const c = line.match(/^(\s*)(#|\/\/)(.*)$/);
			if (c) return `${c[1]}<span class="c">${c[2]}${c[3]}</span>`;
			if (line.startsWith('&gt; ')) return `<span class="p">&gt; </span>${line.slice(5)}`;
			return line
				.replace(/(&#39;|')([^']*)'/g, `<span class="s">'$2'</span>`)
				.replace(/("[^"]*")/g, `<span class="s">$1</span>`)
				.replace(/\b(import|from|const|await|for|of)\b/g, '<span class="k">$1</span>')
				.replace(/^(\s*)\$ /, '$1<span class="p">$ </span>')
				.replace(/(\/\/ .*)$/, '<span class="c">$1</span>');
		})
		.join('\n');

const snippets = [
	{
		id: 'mcp',
		label: 'Claude (MCP)',
		file: 'terminal',
		code: `# Give Claude Code a workspace, held to the token's scopes
$ claude mcp add outflare \\
    -e OUTFLARE_URL=https://outflare.example.com \\
    -e OUTFLARE_TOKEN=oft_... \\
    -e OUTFLARE_WORKSPACE=<workspace id> \\
    -- node ./outflare/mcp/dist/index.js

# Then just ask
> Which mailboxes are under 90% inbox placement?
> Import leads.csv and preview step 1 for 3 leads.`,
	},
	{
		id: 'ts',
		label: 'TypeScript',
		file: 'agent.ts',
		code: `import { createClient } from '@outflare/sdk';

const gtm = createClient({
  baseUrl: 'https://outflare.example.com',
  token: process.env.OUTFLARE_TOKEN, // mailboxes.read
});

// Which mailboxes need attention?
const { data } = await gtm.GET('/v1/workspaces/{ws}/mailboxes', {
  params: { path: { ws }, query: { status: 'error' } },
});

for (const m of data.data) console.log(m.email, m.status_reason);`,
	},
	{
		id: 'curl',
		label: 'curl',
		file: 'terminal',
		code: `# Import 200 reseller inboxes in one call
$ curl -X POST "$GTM/v1/workspaces/$WS/mailboxes/import" \\
    -H "Authorization: Bearer $OUTFLARE_TOKEN" \\
    -H "Content-Type: text/csv" --data-binary @inboxes.csv

{"created": 200, "updated": 0, "errors": []}`,
	},
];

const endpoints = [
	{ m: 'POST', path: '/mailboxes/import', id: 'importMailboxes', what: 'Bulk import inboxes from CSV' },
	{ m: 'GET', path: '/mailboxes', id: 'listMailboxes', what: 'Status, warm-up and limits' },
	{ m: 'POST', path: '/leads/import', id: 'importLeads', what: 'Import up to 100,000 leads' },
	{ m: 'POST', path: '/sequences', id: 'createSequence', what: 'Create a sequence' },
	{ m: 'POST', path: '/sequences/{id}/preview', id: 'previewSequence', what: 'Render steps for real leads' },
	{ m: 'POST', path: '/sequences/{id}/enrollments', id: 'enrollLeads', what: 'Add leads or a list' },
	{ m: 'GET', path: '/inbox', id: 'listInbox', what: 'Replies across every mailbox' },
	{ m: 'POST', path: '/inbox/{id}/reply', id: 'replyToInboundMessage', what: 'Reply in the same thread' },
];
const methodColor: Record<string, string> = {
	GET: 'text-sky-700 dark:text-sky-400 border-sky-500/30 bg-sky-500/10',
	POST: 'text-brand-strong dark:text-brand border-brand/30 bg-brand/10',
	PUT: 'text-amber-700 dark:text-amber-400 border-amber-500/30 bg-amber-500/10',
};

const quickstart = [
	{ n: '01', title: 'Clone', code: 'git clone https://github.com/outflareai/outflare\ncd outflare' },
	{ n: '02', title: 'Configure', code: 'cp deploy/.env.example deploy/.env\necho "OUTFLARE_SECRET_KEY=$(openssl rand -base64 32)" >> deploy/.env' },
	{ n: '03', title: 'Run', code: 'docker compose -f deploy/docker-compose.yml up -d\n# open http://localhost:8080' },
];

const warmup = [62, 70, 74, 79, 83, 86, 88, 90, 91, 93, 94, 94, 95, 95];

const roadmapTag: Record<string, string> = { shipped: 'badge-live', building: 'badge-next', planned: 'badge-muted', later: 'badge-muted' };
---

<Marketing
	title="Outflare: the open-source cold email engine for people and agents"
	description="Self-host a cold email sequencer built for bulk reseller inboxes. Connect hundreds of mailboxes in one upload, warm them up, send through one policy check, and give your agents the same API as your team."
>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-6xl px-4 pt-16 pb-10 text-center sm:px-6 sm:pt-24">
			<a href="/docs/project/roadmap/" class="hit group inline-flex items-center gap-2 rounded-full border bg-background/80 py-1 pr-3 pl-1 text-xs text-muted-foreground shadow-xs backdrop-blur transition-colors hover:text-foreground">
				<span class="badge badge-live rounded-full">Open source</span>
				{shipped} of {v1} v1 steps shipped
				<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
			</a>
			<h1 class="mx-auto mt-6 max-w-4xl bg-gradient-to-b from-foreground to-foreground/65 bg-clip-text pb-1 text-4xl font-semibold tracking-tighter text-balance text-transparent sm:text-6xl sm:leading-[1.05]">
				The cold email engine your agents can run.
			</h1>
			<p class="mx-auto mt-5 max-w-2xl text-base text-pretty text-muted-foreground sm:text-lg">
				Connect hundreds of Google Workspace and Microsoft 365 inboxes in one upload, warm them up, run sequences and
				answer replies. Every send passes one policy check, and everything in the app is in the API.
			</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a href={repo.url} class="btn btn-primary btn-lg w-full sm:w-auto">
					Self-host on GitHub
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
				</a>
				<button type="button" data-copy="git clone https://github.com/outflareai/outflare" class="btn btn-outline btn-lg w-full font-mono text-[13px] font-normal sm:w-auto" aria-label="Copy the git clone command">
					<span class="sm:hidden">Copy the clone command</span><span class="hidden sm:inline"><span class="text-muted-foreground select-none">$</span> git clone github.com/outflareai/outflare</span>
					<svg data-icon="copy" class="text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
					<svg data-icon="done" class="hidden text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
				</button>
			</div>
			<p class="mt-4 text-sm text-muted-foreground">Questions, or want help setting it up? <a href={`mailto:${site.email}`} class="font-medium text-foreground underline-offset-4 hover:underline">Get in touch</a></p>
			<ul class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 font-mono text-xs text-muted-foreground">
				{['AGPL-3.0', 'Go + Postgres', 'OpenAPI 3.1', 'MCP server', 'No per-mailbox fees'].map((t) => <li class="flex items-center gap-1.5"><svg class="size-3.5 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t}</li>)}
			</ul>
		</div>

		<!-- Product -->
		<div class="relative mx-auto max-w-6xl px-4 pb-20 sm:px-6">
			<div class="relative z-10 mb-4 flex justify-center">
				<div role="tablist" aria-label="App screens" class="inline-flex max-w-full gap-1 overflow-x-auto rounded-lg border bg-muted/60 p-1">
					{
						shots.map((s, i) => (
							<button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`shot-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-shot={s.id} class="tab px-3 py-1.5 text-sm hover:bg-background/50 aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-xs">
								{s.label}
							</button>
						))
					}
				</div>
			</div>
			<div class="relative">
				<div class="pointer-events-none absolute -inset-x-10 -top-10 -bottom-4 -z-0 rounded-[2rem] bg-[radial-gradient(ellipse_at_top,color-mix(in_oklch,var(--color-brand)_22%,transparent),transparent_65%)] blur-2xl" aria-hidden="true"></div>
				<div class="relative overflow-hidden rounded-xl border bg-card shadow-2xl shadow-black/20 ring-1 ring-black/5 dark:shadow-black/60 dark:ring-white/5">
					<div class="flex items-center gap-2 border-b px-4 py-2.5">
						<span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
						<span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
						<span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
						<span class="mx-auto rounded-md bg-muted px-3 py-0.5 font-mono text-[11px] text-muted-foreground">outflare.yourcompany.com</span>
						<span class="w-12"></span>
					</div>
					{
						shots.map((s, i) => (
							<div role="tabpanel" id={`shot-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0} data-panel={s.id}>
								<img class="only-dark block w-full max-sm:-ml-[28%] max-sm:w-[168%] max-sm:max-w-none" src={`/app/${s.id}-dark.webp`} width="2880" height="1520" alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
								<img class="only-light block w-full max-sm:-ml-[28%] max-sm:w-[168%] max-sm:max-w-none" src={`/app/${s.id}-light.webp`} width="2880" height="1520" alt={s.alt} loading="lazy" />
							</div>
						))
					}
				</div>
			</div>
			<p class="mt-4 text-center text-xs text-muted-foreground">The real app, running on demo data. Every screen is also an API endpoint.</p>
		</div>
	</section>

	<!-- Works with -->
	<section class="border-y bg-muted/30">
		<div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-8 sm:flex-row sm:justify-between sm:px-6">
			<p class="text-sm text-muted-foreground">Works with the inboxes and agents you already use</p>
			<ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-sm font-medium text-foreground/70">
				<li>Google Workspace</li>
				<li>Microsoft 365</li>
				<li>Any SMTP + IMAP</li>
				<li>Claude</li>
				<li>Cursor</li>
				<li>Any MCP client</li>
			</ul>
		</div>
	</section>

	<!-- Bento -->
	<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
		<p class="eyebrow"><span class="text-foreground">01</span> / Product</p>
		<h2 class="h2 mt-3 max-w-3xl">Everything a sending team needs. One binary and a Postgres.</h2>
		<p class="sub">Built for teams running hundreds of reseller inboxes, and for the agents working alongside them.</p>

		<div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-6 [&>*]:min-w-0">
			<!-- Bulk import -->
			<a href="/docs/guides/import-mailboxes/" class="card group flex flex-col overflow-hidden transition-colors hover:border-foreground/20 md:col-span-4">
				<div class="p-6 pb-0">
					<span class="mb-4 flex size-8 items-center justify-center rounded-md border bg-muted/60 text-muted-foreground"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5"/><path d="M12 3v12"/></svg></span>
					<h3 class="font-semibold">Connect 200 inboxes in one upload</h3>
					<p class="mt-1.5 text-sm text-muted-foreground">Drop the CSV your reseller sends. Google and Microsoft are detected, SMTP and IMAP sign-in is checked, and passwords are encrypted at rest.</p>
				</div>
				<div class="mt-6 flex-1 border-t bg-muted/30 p-4">
					<div class="flex items-center justify-between rounded-lg border border-dashed bg-background px-3 py-2 text-sm">
						<span class="font-mono text-xs">inboxes.csv <span class="text-muted-foreground">· 200 rows</span></span>
						<span class="badge badge-live">200 created · 0 errors</span>
					</div>
					<table class="mt-3 w-full table-fixed text-left text-[13px] [&_td:first-child]:truncate">
						<thead><tr class="font-mono text-[11px] tracking-wide text-muted-foreground uppercase"><th class="w-[44%] py-1.5 font-medium">Mailbox</th><th class="py-1.5 font-medium">Status</th><th class="hidden py-1.5 font-medium sm:table-cell">Warm-up</th><th class="py-1.5 text-right font-medium">Limit</th></tr></thead>
						<tbody class="divide-y">
							{
								[['alex@trynorthwind.com', '96%', 40], ['sam@trynorthwind.com', '94%', 40], ['jordan@northwindhq.com', '95%', 50], ['riley@getnorthwind.io', '93%', 30]].map(([m, w, l]) => (
									<tr><td class="py-1.5 font-mono text-xs">{m}</td><td><span class="badge badge-live">Sending</span></td><td class="hidden sm:table-cell"><span class="badge badge-live">{w} inbox</span></td><td class="text-right tabular-nums">{l}/day</td></tr>
								))
							}
						</tbody>
					</table>
				</div>
			</a>

			<!-- Policy check -->
			<a href="/docs/concepts/policy-check/" class="card flex flex-col p-6 transition-colors hover:border-foreground/20 md:col-span-2">
				<span class="mb-4 flex size-8 items-center justify-center rounded-md border bg-muted/60 text-muted-foreground"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span>
				<h3 class="font-semibold">One policy check on every send</h3>
				<p class="mt-1.5 text-sm text-muted-foreground">Run by the engine right before SMTP. No sequence, script or agent can send around it.</p>
				<ul class="mt-5 space-y-2 text-[13px]">
					{['Suppression list', 'Unsubscribes and bounces', 'Mailbox and domain daily limits', 'Sending window'].map((c) => (
						<li class="flex items-center gap-2"><svg class="size-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{c}</li>
					))}
					<li class="flex items-start gap-2 rounded-md border border-destructive/30 bg-destructive/10 px-2 py-1.5 text-destructive"><svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m5.6 5.6 12.8 12.8"></path></svg><span><b class="font-medium">Blocked:</b> dana@acme.com is on the suppression list</span></li>
				</ul>
			</a>

			<!-- Domains -->
			<a href="/docs/guides/sending-domains/" class="card flex flex-col p-6 transition-colors hover:border-foreground/20 md:col-span-2">
				<span class="mb-4 flex size-8 items-center justify-center rounded-md border bg-muted/60 text-muted-foreground"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></span>
				<h3 class="font-semibold">Domain health, checked daily</h3>
				<p class="mt-1.5 text-sm text-muted-foreground">SPF, DKIM, DMARC, MX and blocklists for every sending domain, with the exact record to fix.</p>
				<ul class="mt-5 space-y-2.5">
					{[['trynorthwind.com', ['SPF', 'DKIM', 'DMARC'], ''], ['northwindhq.com', ['SPF', 'DKIM', 'DMARC'], ''], ['getnorthwind.io', ['SPF', 'DKIM'], 'DMARC']].map(([d, ok, warn]) => (
						<li class="flex flex-wrap items-center justify-between gap-2">
							<span class="font-mono text-xs">{d}</span>
							<span class="flex gap-1">
								{(ok as string[]).map((r) => <span class="badge badge-live">✓ {r}</span>)}
								{warn && <span class="badge badge-next">! {warn}</span>}
							</span>
						</li>
					))}
				</ul>
			</a>

			<!-- Warm-up -->
			<a href="/docs/guides/warmup/" class="card flex flex-col p-6 transition-colors hover:border-foreground/20 md:col-span-2">
				<span class="mb-4 flex size-8 items-center justify-center rounded-md border bg-muted/60 text-muted-foreground"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg></span>
				<div class="flex items-start justify-between gap-4">
					<div>
						<h3 class="font-semibold">Built-in warm-up</h3>
						<p class="mt-1.5 text-sm text-muted-foreground">Your mailboxes warm each other up on a daily ramp, with spam rescue.</p>
					</div>
					<div class="text-right">
						<div class="text-2xl font-semibold tracking-tight text-brand-strong tabular-nums dark:text-brand">95%</div>
						<div class="font-mono text-[10px] tracking-wide whitespace-nowrap text-muted-foreground uppercase">inbox · 7d</div>
					</div>
				</div>
				<div class="mt-auto flex h-24 items-end gap-1 pt-6" role="img" aria-label="Inbox placement rising from 62% to 95% over 14 days">
					{warmup.map((v) => <span class="flex-1 rounded-sm bg-brand/70" style={`height:${v}%`}></span>)}
				</div>
			</a>

			<!-- Inbox -->
			<a href="/docs/guides/inbox/" class="card flex flex-col p-6 transition-colors hover:border-foreground/20 md:col-span-2">
				<span class="mb-4 flex size-8 items-center justify-center rounded-md border bg-muted/60 text-muted-foreground"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg></span>
				<h3 class="font-semibold">Every reply in one inbox</h3>
				<p class="mt-1.5 text-sm text-muted-foreground">Replies stop the sequence. Opt-outs are suppressed. Answer from the same mailbox and thread.</p>
				<ul class="mt-5 divide-y rounded-lg border text-[13px]">
					<li class="flex items-center gap-2 px-3 py-2"><span class="size-1.5 rounded-full bg-brand"></span><b class="font-medium whitespace-nowrap">Zoe Okafor</b><span class="truncate text-muted-foreground">Does it work with our Google inboxes?</span></li>
					<li class="flex items-center gap-2 px-3 py-2"><span class="size-1.5 rounded-full bg-brand"></span><b class="font-medium whitespace-nowrap">Theo Haddad</b><span class="truncate text-muted-foreground">Yes, keen to chat this week.</span></li>
					<li class="flex items-center gap-2 px-3 py-2"><span class="size-1.5"></span><span>Owen Patel</span><span class="badge badge-next ml-auto">Asked to be removed</span></li>
				</ul>
			</a>

			<!-- Audit -->
			<a href="/docs/guides/workspaces-and-access/#audit-log" class="card flex flex-col p-6 transition-colors hover:border-foreground/20 md:col-span-3">
				<span class="mb-4 flex size-8 items-center justify-center rounded-md border bg-muted/60 text-muted-foreground"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/></svg></span>
				<h3 class="font-semibold">Scoped tokens, everything audited</h3>
				<p class="mt-1.5 text-sm text-muted-foreground">Tokens are bound to one workspace and never outrank the person who made them. Every change is logged under who did it.</p>
				<ul class="mt-5 space-y-1.5 font-mono text-xs">
