---
import Marketing from '../layouts/Marketing.astro';
import { app, repo, site } from '../data/project';
import { modules, moduleStatusLabel } from '../data/modules';

const liveModules = modules.filter((m) => m.status === 'live').length;

// Real screenshots of the web app (outflare web/), taken from a local demo
// workspace where every name and domain is fictional (.example).
const shots = [
	{ id: 'analytics', label: 'Analytics', alt: 'Website analytics: visitors, page views, visits, search clicks and impressions for one website from Google Analytics, Search Console and PostHog, with an Ahrefs SEO line' },
	{ id: 'seo', label: 'SEO', alt: 'SEO: an Ahrefs connection with its monthly budget, and the keywords the site ranks for with position, change, searches and estimated visits' },
	{ id: 'missions', label: 'Missions', alt: 'Missions: a box to start a mission from a goal, counts of running missions and plans to approve, and a list of missions with their status and goal' },
	{ id: 'inbox-item', label: 'Inbox', alt: 'Inbox: conversations sorted by meaning, with one open and a reply box sending from the same address' },
	{ id: 'connectors', label: 'Connectors', alt: 'Connectors: Ahrefs, Apollo, Google Analytics, Google Calendar, Google Search Console and HubSpot, each connected' },
];

const worksWith = ['Google Analytics', 'Search Console', 'HubSpot', 'Ahrefs', 'PostHog', 'Google Workspace', 'Microsoft 365', 'Claude', 'ChatGPT', 'Cursor'];

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Tiny highlighter for the hand-written snippets below: //, # comments,
// quoted strings and a few keywords.
const hl = (src: string) =>
	esc(src)
		.split('\n')
		.map((line) => {
			const c = line.match(/^(\s*)(#|\/\/)(.*)$/);
			if (c) return `${c[1]}<span class="c">${c[2]}${c[3]}</span>`;
			if (line.startsWith('&gt; ')) return `<span class="p">&gt; </span>${line.slice(5)}`;
			return line
				.replace(/(&#39;|')([^']*)'/g, `<span class="s">'$2'</span>`)
				.replace(/("[^"]*")/g, `<span class="s">$1</span>`)
				.replace(/\b(import|from|const|await|for|of)\b/g, '<span class="k">$1</span>')
				.replace(/^(\s*)\$ /, '$1<span class="p">$ </span>')
				.replace(/(\/\/ .*)$/, '<span class="c">$1</span>');
		})
		.join('\n');

const snippets = [
	{
		id: 'mcp',
		label: 'Claude (MCP)',
		file: 'terminal',
		code: `# Connect Claude Code to your workspace: one URL, then approve in the browser
$ claude mcp add --transport http outflare https://app.outflare.ai/mcp

# Then just ask
> What changed on our website this week, and why?
> Which keywords did we lose, and which pages do they point to?`,
	},
	{
		id: 'ts',
		label: 'TypeScript',
		file: 'agent.ts',
		code: `import { createClient } from '@outflare/sdk';

const gtm = createClient({
  baseUrl: 'https://app.outflare.ai',
  token: process.env.OUTFLARE_TOKEN, // analytics.read
});

// What moved on each website?
const { data } = await gtm.GET('/v1/workspaces/{ws}/analytics/changes', {
  params: { path: { ws } },
});

for (const w of data.websites) console.log(w.host, w.headline.join(' '));`,
	},
	{
		id: 'curl',
		label: 'curl',
		file: 'terminal',
		code: `# Every keyword a site ranks for, with the change since last week
$ curl "$GTM/v1/workspaces/$WS/seo/history?report=keywords" \\
    -H "Authorization: Bearer $OUTFLARE_TOKEN"`,
	},
];

const endpoints = [
	{ m: 'GET', path: '/analytics/overview', id: 'getAnalyticsOverview', what: 'Every website, every tool' },
	{ m: 'GET', path: '/analytics/changes', id: 'getAnalyticsChanges', what: 'What changed, and where' },
	{ m: 'GET', path: '/seo/history', id: 'getSEOHistory', what: 'Rankings, backlinks, audits' },
	{ m: 'POST', path: '/missions', id: 'createMission', what: 'Give an agent a goal' },
	{ m: 'GET', path: '/integrations', id: 'listIntegrations', what: 'Connected tools' },
	{ m: 'GET', path: '/inbox', id: 'listInbox', what: 'Every conversation' },
	{ m: 'POST', path: '/leads/import', id: 'importLeads', what: 'Import up to 100,000 leads' },
	{ m: 'POST', path: '/sequences', id: 'createSequence', what: 'Create an email campaign' },
];
const methodColor: Record<string, string> = {
	GET: 'text-sky-700 dark:text-sky-400 border-sky-500/30 bg-sky-500/10',
	POST: 'text-brand-strong dark:text-brand border-brand/30 bg-brand/10',
	PUT: 'text-amber-700 dark:text-amber-400 border-amber-500/30 bg-amber-500/10',
};

const moduleTag: Record<string, string> = { live: 'badge-live', building: 'badge-next', planned: 'badge-muted' };

const principles = [
	{ title: 'Connect what you already use', body: 'Sign in once with OAuth or paste a key, and Outflare reads from your analytics, search, CRM, calendar and data tools. No connector is required to start.' },
	{ title: 'Ask, or hand over a goal', body: 'Ask a question from Claude, ChatGPT or Cursor, or give an agent a mission. It reads your company and brand context first, so you never explain twice.' },
	{ title: 'Stay in control', body: 'Agents work through scoped tokens, within send and spend limits, and wait for your approval where you choose. Every action is logged under who did it.' },
];

const quickstart = [
	{ n: '01', title: 'Clone', code: 'git clone https://github.com/outflareai/outflare\ncd outflare' },
	{ n: '02', title: 'Configure', code: 'cp deploy/.env.example deploy/.env\necho "OUTFLARE_SECRET_KEY=$(openssl rand -base64 32)" >> deploy/.env' },
	{ n: '03', title: 'Run', code: 'docker compose -f deploy/docker-compose.yml up -d\n# open http://localhost:8080' },
];


---

<Marketing
	title="Outflare: the open-source GTM platform for people and agents"
	description="One open-source workspace for your go-to-market: connect your analytics, search, CRM and email tools, see what's working, and let your AI agents do the work through one API. Hosted or self-hosted."
>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-6xl px-4 pt-16 pb-10 text-center sm:px-6 sm:pt-24">
			<a href="#modules" class="hit group inline-flex items-center gap-2 rounded-full border bg-background/80 py-1 pr-3 pl-1 text-xs text-muted-foreground shadow-xs backdrop-blur transition-colors hover:text-foreground">
				<span class="badge badge-live rounded-full">Open source</span>
				{liveModules} modules live, more on the way
				<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
			</a>
			<h1 class="mx-auto mt-6 max-w-4xl bg-gradient-to-b from-foreground to-foreground/65 bg-clip-text pb-1 text-4xl font-semibold tracking-tighter text-balance text-transparent sm:text-6xl sm:leading-[1.05]">
				The GTM platform your agents can run.
			</h1>
			<p class="mx-auto mt-5 max-w-2xl text-base text-pretty text-muted-foreground sm:text-lg">
				Outflare brings your go-to-market into one workspace. Connect the tools you already use, see what's working across
				your website, search and campaigns, and let your AI agents do the work through one API.
			</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a href={app.url} data-signed-in data-track="dashboard_click" class="btn btn-primary btn-lg w-full sm:w-auto">
					Open your dashboard
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
				</a>
				<a href={app.signUp} data-signed-out class="btn btn-primary btn-lg w-full sm:w-auto">
					Sign up free
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
				</a>
				<a href={repo.url} class="btn btn-outline btn-lg w-full sm:w-auto">Self-host on GitHub</a>
			</div>
			<p data-signed-out class="mt-4 text-sm text-muted-foreground">Hosted Outflare is free during early access. Have an account? <a href={app.signIn} class="hit font-medium text-foreground underline-offset-4 hover:underline">Sign in</a></p>
			<ul class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 font-mono text-xs text-muted-foreground">
				{['AGPL-3.0', '82 connectors', 'MCP server', 'OpenAPI 3.1', 'Bring your own AI key'].map((t) => <li class="flex items-center gap-1.5"><svg class="size-3.5 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t}</li>)}
			</ul>
		</div>

		<!-- Product -->
		<div class="relative mx-auto max-w-6xl px-4 pb-20 sm:px-6">
			<div class="relative z-10 mb-4 flex justify-center">
				<div role="tablist" aria-label="App screens" class="inline-flex max-w-full gap-1 overflow-x-auto rounded-lg border bg-muted/60 p-1">
					{
						shots.map((s, i) => (
							<button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`shot-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-shot={s.id} class="tab px-3 py-1.5 text-sm hover:bg-background/50 aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-xs">
								{s.label}
							</button>
						))
					}
				</div>
			</div>
			<div class="relative">
				<div class="pointer-events-none absolute -inset-x-10 -top-10 -bottom-4 -z-0 rounded-[2rem] bg-[radial-gradient(ellipse_at_top,color-mix(in_oklch,var(--color-brand)_22%,transparent),transparent_65%)] blur-2xl" aria-hidden="true"></div>
				<div class="relative overflow-hidden rounded-xl border bg-card shadow-2xl shadow-black/20 ring-1 ring-black/5 dark:shadow-black/60 dark:ring-white/5">
					<div class="flex items-center gap-2 border-b px-4 py-2.5">
						<span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
						<span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
						<span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
						<span class="mx-auto rounded-md bg-muted px-3 py-0.5 font-mono text-[11px] text-muted-foreground">app.outflare.ai</span>
						<span class="w-12"></span>
					</div>
					{
						shots.map((s, i) => (
							<div role="tabpanel" id={`shot-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0} data-panel={s.id}>
								<img class="only-dark block w-full max-sm:-ml-[28%] max-sm:w-[168%] max-sm:max-w-none" src={`/app/${s.id}-dark.webp`} width="2880" height="1520" alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
								<img class="only-light block w-full max-sm:-ml-[28%] max-sm:w-[168%] max-sm:max-w-none" src={`/app/${s.id}-light.webp`} width="2880" height="1520" alt={s.alt} loading="lazy" />
							</div>
						))
					}
				</div>
			</div>
			<p class="mt-4 text-center text-xs text-muted-foreground">The real app, on a demo workspace. Every screen is also an API endpoint.</p>
		</div>
	</section>

	<!-- Works with -->
	<section class="border-y bg-muted/30">
		<div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-8 sm:px-6 lg:flex-row lg:justify-between">
			<p class="shrink-0 text-sm text-muted-foreground">Works with the tools and agents you already use</p>
			<ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-medium text-foreground/70">
				{worksWith.map((t) => <li>{t}</li>)}
				<li><a href="/docs/integrations/connectors/" class="hit text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">and 70 more</a></li>
			</ul>
		</div>
	</section>

	<!-- Modules -->
	<section id="modules" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6">
		<p class="eyebrow"><span class="text-foreground">01</span> / Modules</p>
		<h2 class="h2 mt-3 max-w-3xl">One workspace for your whole go-to-market.</h2>
		<p class="sub">Each module shares the same connectors, context, people and API, so a new one works with everything you've already set up. Use one, or all of them.</p>
		<ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				modules.map((m) => (
					<li class={`card relative flex flex-col p-6 ${m.docs ? 'transition-colors has-[a:hover]:border-foreground/20' : ''}`}>
						<div class="mb-4 flex items-center justify-between gap-2">
							<span class="flex size-8 items-center justify-center rounded-md border bg-muted/60 text-muted-foreground"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={m.icon} /></span>
							<span class={`badge ${moduleTag[m.status]}`}>{moduleStatusLabel[m.status]}</span>
						</div>
						{m.docs ? <a href={m.docs} class="font-semibold after:absolute after:inset-0 after:content-[''] hover:underline">{m.name}</a> : <h3 class="font-semibold">{m.name}</h3>}
						<p class="mt-1.5 text-sm text-muted-foreground">{m.summary}</p>
					</li>
				))
			}
		</ul>
		<a href="/docs/project/roadmap/" class="hit mt-8 inline-block text-sm font-medium underline-offset-4 hover:underline">See the roadmap →</a>
	</section>

	<!-- Agents -->
	<section class="border-y bg-muted/30">
		<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-24 pb-12 sm:px-6 lg:grid-cols-[1fr_1.15fr]">
			<div>
				<p class="eyebrow"><span class="text-foreground">02</span> / API and agents</p>
				<h2 class="h2 mt-3">Your agents get a real API, not a browser.</h2>
				<p class="sub">The web app has no private endpoints. Whatever it does, your scripts and agents can do through the same documented API, with limits they can't talk their way past.</p>
				<dl class="mt-8 grid gap-5 sm:grid-cols-2">
					<div><dt class="font-medium">Connect your AI</dt><dd class="mt-1 text-sm text-muted-foreground">One URL for Claude, ChatGPT, Cursor and any MCP app, with 238 tools. Sign in, approve, then just ask.</dd></div>
					<div><dt class="font-medium">OpenAPI 3.1</dt><dd class="mt-1 text-sm text-muted-foreground">One contract, served by every instance at <code class="text-xs">/v1/openapi.yaml</code>.</dd></div>
					<div><dt class="font-medium">Typed SDK</dt><dd class="mt-1 text-sm text-muted-foreground">An Apache-2.0 TypeScript client generated from the contract.</dd></div>
					<div><dt class="font-medium">Attributed</dt><dd class="mt-1 text-sm text-muted-foreground">Every action lands in the audit log under the token's name.</dd></div>
				</dl>
				<a href="/docs/agents/connect/" class="btn btn-outline mt-8">Connect your AI →</a>
			</div>
			<div class="card overflow-hidden shadow-xl shadow-black/5 dark:shadow-black/40">
				<div class="flex items-center gap-1 border-b px-2 py-1.5" role="tablist" aria-label="Code examples">
					{
						snippets.map((s, i) => (
							<button type="button" role="tab" id={`code-tab-${s.id}`} aria-controls={`code-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-code={s.id} class="tab px-2.5 py-1 text-[13px] hover:bg-muted/50 aria-selected:bg-muted aria-selected:text-foreground">
								{s.label}
							</button>
						))
					}
				</div>
				{
					snippets.map((s, i) => (
						<pre role="tabpanel" id={`code-${s.id}`} aria-labelledby={`code-tab-${s.id}`} hidden={i !== 0} data-code-panel={s.id} class="code-panel lg:min-h-[19.5rem]"><code set:html={hl(s.code)} /></pre>
					))
				}
			</div>
		</div>
		<div class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
			<div class="card overflow-hidden">
				<div class="flex flex-wrap items-center justify-between gap-2 border-b px-4 py-3">
					<span class="text-sm font-medium">Every screen is an endpoint</span>
					<a href="/docs/api/reference/" class="hit font-mono text-xs text-muted-foreground hover:text-foreground">/v1/workspaces/{'{ws}'}/… · full reference →</a>
				</div>
				<ul class="grid divide-y md:grid-cols-2 md:divide-y-0 [&>li]:border-b md:[&>li:nth-last-child(-n+2)]:border-b-0 md:[&>li:nth-child(odd)]:border-r">
					{endpoints.map((e) => (
						<li>
							<a href={`/docs/api/reference/#${e.id}`} class="flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50">
								<span class={`w-12 shrink-0 rounded border py-px text-center font-mono text-[10px] font-semibold ${methodColor[e.m]}`}>{e.m}</span>
								<span class="truncate font-mono text-[13px]">{e.path}</span>
								<span class="ml-auto hidden truncate text-xs text-muted-foreground sm:block">{e.what}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<!-- How it works -->
	<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
		<p class="eyebrow"><span class="text-foreground">03</span> / How it works</p>
		<h2 class="h2 mt-3 max-w-3xl">Outflare is the brain. Your tools stay where they are.</h2>
		<p class="sub">Outflare reads from the tools you already pay for, keeps the history in one place, and gives people and agents the same view and the same controls.</p>
		<ol class="mt-12 grid gap-4 md:grid-cols-3">
			{
				principles.map((p, i) => (
					<li class="card p-6">
						<span class="font-mono text-xs text-muted-foreground">0{i + 1}</span>
						<h3 class="mt-3 font-semibold">{p.title}</h3>
						<p class="mt-1.5 text-sm text-muted-foreground">{p.body}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- Quickstart -->
	<section class="border-t">
		<div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
			<div class="flex flex-wrap items-end justify-between gap-6">
				<div>
					<p class="eyebrow"><span class="text-foreground">04</span> / Quickstart</p>
					<h2 class="h2 mt-3">Running on your machine in three commands.</h2>
					<p class="sub">Docker Compose starts the engine and Postgres. The web app, API and OpenAPI spec are all on port 8080.</p>
				</div>
				<a href="/docs/quickstart/" class="btn btn-outline">Full quickstart →</a>
			</div>
			<ol class="mt-10 grid gap-3">
				{
					quickstart.map((q) => (
						<li class="card grid min-w-0 overflow-hidden md:grid-cols-[12rem_1fr]">
							<div class="flex items-center justify-between border-b px-4 py-2.5 md:flex-col md:items-start md:justify-center md:gap-2 md:border-r md:border-b-0">
								<span class="flex items-center gap-2 text-sm font-medium"><span class="font-mono text-xs text-muted-foreground">{q.n}</span>{q.title}</span>
								<button type="button" data-copy={q.code.split('\n').filter((l) => !l.startsWith('#')).join('\n')} class="btn btn-ghost h-7 gap-1 px-2 text-xs md:-ml-2" aria-label={`Copy the ${q.title.toLowerCase()} commands`}>
									<svg data-icon="copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
									<svg data-icon="done" class="hidden text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
									Copy
								</button>
							</div>
							<pre class="code-panel bg-muted/30 text-xs md:py-5"><code set:html={hl(q.code.split('\n').map((l) => (l.startsWith('#') ? l : '$ ' + l)).join('\n'))} /></pre>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Open source -->
	<section class="border-t">
		<div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
			<p class="eyebrow"><span class="text-foreground">05</span> / Open source</p>
			<h2 class="h2 mt-3 max-w-3xl">The platform that holds your customer data should be one you can read.</h2>
			<div class="mt-12 grid gap-10 lg:grid-cols-[1fr_1.2fr]">
				<dl class="grid content-start gap-6 sm:grid-cols-2">
					<div><dt class="font-medium">You own the data</dt><dd class="mt-1 text-sm text-muted-foreground">Analytics history, leads, conversations and every action live in your Postgres.</dd></div>
					<div><dt class="font-medium">Your AI, your key</dt><dd class="mt-1 text-sm text-muted-foreground">Agents run on your own model key, so you choose the model and see what it costs.</dd></div>
					<div><dt class="font-medium">No pricing page to outgrow</dt><dd class="mt-1 text-sm text-muted-foreground">Free to self-host, and free hosted while we're in early access.</dd></div>
					<div><dt class="font-medium">Build on it freely</dt><dd class="mt-1 text-sm text-muted-foreground">The SDK is Apache-2.0, so integrations carry no copyleft.</dd></div>
				</dl>
				<div class="card overflow-x-auto">
					<table class="w-full min-w-[30rem] text-left text-sm">
						<thead>
							<tr class="border-b font-mono text-[11px] tracking-wide text-muted-foreground uppercase">
								<th class="px-4 py-3 font-medium"><span class="sr-only">Compare</span></th>
								<th class="px-4 py-3 font-medium">A typical GTM stack</th>
								<th class="px-4 py-3 font-medium text-foreground">Outflare</th>
							</tr>
						</thead>
						<tbody class="divide-y">
							{[
								['Your data lives in', 'A dozen vendor databases', 'Your Postgres'],
								['Reporting', 'One dashboard per tool', 'Every tool side by side'],
								['Pricing', 'Per seat, contact or tool', 'Free to self-host, free hosted in early access'],
								['API', 'Varies by vendor and plan', 'Everything, OpenAPI 3.1'],
								['Agent access', 'One key per account', 'Scoped, audited tokens + MCP'],
								['If you outgrow it', 'Export and migrate', 'Fork it'],
							].map(([k, a, b]) => (
								<tr><th class="px-4 py-2.5 font-normal text-muted-foreground">{k}</th><td class="px-4 py-2.5 text-muted-foreground">{a}</td><td class="px-4 py-2.5 font-medium">{b}</td></tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
			<a href="/docs/project/license/" class="hit mt-8 inline-block text-sm font-medium underline-offset-4 hover:underline">How the licensing works →</a>
		</div>
	</section>

	<!-- Final CTA -->
	<section class="relative overflow-hidden border-t">
		<div class="grid-bg pointer-events-none absolute inset-0" style="--grid-mask: radial-gradient(ellipse 60% 90% at 50% 100%, #000 30%, transparent 100%)" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
			<h2 class="text-3xl font-semibold tracking-tighter text-balance sm:text-5xl">Use it hosted, or run it yourself.</h2>
			<p class="mx-auto mt-4 max-w-xl text-muted-foreground sm:text-lg">Sign up and connect your first tools in a few minutes, free while we're in early access. Or run it yourself: two containers and one settings file.</p>
			<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
				<a href={app.url} data-signed-in data-track="dashboard_click" class="btn btn-primary btn-lg">Open your dashboard</a>
				<a href={app.signUp} data-signed-out class="btn btn-primary btn-lg">Sign up free</a>
				<a href={repo.url} class="btn btn-outline btn-lg">Self-host on GitHub</a>
				<a href={app.signIn} data-signed-out class="btn btn-ghost btn-lg">Sign in</a>
			</div>
			<p class="mt-4 text-sm text-muted-foreground">Questions, or want help setting it up? <a href={`mailto:${site.email}`} class="hit font-medium text-foreground underline-offset-4 hover:underline">Get in touch</a></p>
			<p class="mt-6 font-mono text-xs text-muted-foreground"><span class="select-none">$ </span>docker compose -f deploy/docker-compose.yml up -d</p>
		</div>
	</section>
</Marketing>

<style is:global>
	/* Hide the signed-in links until the header's check says so (the same rule as SignedIn.astro). */
	html[data-signed-in] [data-signed-out], html:not([data-signed-in]) [data-signed-in] { display: none !important; }
</style>

<script>
	// Tabs: product screenshots and code examples.
	const tabs = (attr: string, panelAttr: string) => {
		const buttons = [...document.querySelectorAll<HTMLButtonElement>(`[${attr}]`)];
		const select = (b: HTMLButtonElement) => {
			const id = b.getAttribute(attr);
			buttons.forEach((x) => {
				x.setAttribute('aria-selected', String(x === b));
				x.tabIndex = x === b ? 0 : -1;
			});
			document.querySelectorAll<HTMLElement>(`[${panelAttr}]`).forEach((p) => (p.hidden = p.getAttribute(panelAttr) !== id));
		};
		buttons.forEach((b, i) => {
			b.addEventListener('click', () => select(b));
			b.addEventListener('keydown', (e) => {
				const last = buttons.length - 1;
				const to = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
				if (to === undefined) return;
				e.preventDefault();
				const next = buttons[to];
				next.focus();
				next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
				select(next);
			});
		});
	};
	tabs('data-shot', 'data-panel');
	tabs('data-code', 'data-code-panel');

	// Copy the clone command.
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
		b.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(b.dataset.copy ?? '');
			} catch {
				return;
			}
			const [copy, done] = ['copy', 'done'].map((n) => b.querySelector(`[data-icon=${n}]`));
			copy?.classList.add('hidden');
			done?.classList.remove('hidden');
			setTimeout(() => {
				copy?.classList.remove('hidden');
				done?.classList.add('hidden');
			}, 1600);
		}),
	);
</script>
