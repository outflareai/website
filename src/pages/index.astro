<script>
	// Tabs: product screenshots and code examples.
	const tabs = (attr: string, panelAttr: string) => {
		const buttons = [...document.querySelectorAll<HTMLButtonElement>(`[${attr}]`)];
		const select = (b: HTMLButtonElement) => {
			const id = b.getAttribute(attr);
			buttons.forEach((x) => {
				x.setAttribute('aria-selected', String(x === b));
				x.tabIndex = x === b ? 0 : -1;
			});
			document.querySelectorAll<HTMLElement>(`[${panelAttr}]`).forEach((p) => (p.hidden = p.getAttribute(panelAttr) !== id));
		};
		buttons.forEach((b, i) => {
			b.addEventListener('click', () => select(b));
			b.addEventListener('keydown', (e) => {
				const last = buttons.length - 1;
				const to = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
				if (to === undefined) return;
				e.preventDefault();
				const next = buttons[to];
				next.focus();
				next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
				select(next);
			});
		});
	};
	tabs('data-shot', 'data-panel');
	tabs('data-code', 'data-code-panel');

	// Copy the clone command.
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
		b.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(b.dataset.copy ?? '');
			} catch {
				return;
			}
			const [copy, done] = ['copy', 'done'].map((n) => b.querySelector(`[data-icon=${n}]`));
			copy?.classList.add('hidden');
			done?.classList.remove('hidden');
			setTimeout(() => {
				copy?.classList.remove('hidden');
				done?.classList.add('hidden');
			}, 1600);
		}),
	);
</script>
