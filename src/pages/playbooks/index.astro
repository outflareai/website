---
import Marketing from '../../layouts/Marketing.astro';
import { app } from '../../data/project';
import { contributeURL, goalLabel, playbooks, tiers } from '../../data/playbooks';

const goals = [...new Set(playbooks.flatMap((p) => p.goals))];
const groups = tiers.map((t) => ({ ...t, items: playbooks.filter((p) => p.tier === t.id) })).filter((g) => g.items.length > 0);
---

<Marketing title="Playbooks · Outflare" description={`${playbooks.length} ready-made growth playbooks, from welcoming new sign-ups to getting named in AI answers. Copy the prompt into your AI app, or run it in Outflare on your own accounts. Anyone can add one on GitHub.`}>
	<section class="relative border-b">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
			<p class="eyebrow">Playbooks</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tighter text-balance sm:text-5xl">Growth recipes your agent can run</h1>
			<p class="sub">Each playbook says what it needs, the steps it takes with Outflare's tools, what it will never do and how you'll know it worked. Copy the prompt into Claude, ChatGPT or Cursor with Outflare connected, or start it in Outflare as a mission that waits for your approval.</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href={app.signUp} class="btn btn-primary btn-lg">Sign up free</a>
				<a href={contributeURL} class="btn btn-outline btn-lg" data-track="playbook_contribute_click" data-track-label="hero">Write a playbook</a>
			</div>

			<div class="mt-12 flex gap-1.5 overflow-x-auto pb-1" role="group" aria-label="Filter by goal">
				<button type="button" class="btn btn-sm btn-ghost shrink-0 aria-pressed:bg-accent aria-pressed:text-foreground" data-filter="" aria-pressed="true" data-track="playbooks_filter" data-track-label="all">All</button>
				{goals.map((g) => <button type="button" class="btn btn-sm btn-ghost shrink-0 aria-pressed:bg-accent aria-pressed:text-foreground" data-filter={g} aria-pressed="false" data-track="playbooks_filter" data-track-label={g}>{goalLabel(g)}</button>)}
			</div>
		</div>
	</section>

	<div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
		{
			groups.map((g) => (
				<section id={g.id} class="scroll-mt-20 pt-14" data-group>
					<h2 class="text-xl font-semibold tracking-tight">{g.label}</h2>
					<p class="mt-1 text-sm text-muted-foreground">{g.blurb}</p>
					<ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
						{g.items.map((p) => (
							<li data-item data-goals={p.goals.join(' ')}>
								<a href={`/playbooks/${p.id}/`} data-track="playbook_open" data-track-label={p.id} class="card flex h-full flex-col gap-2 p-4 transition-colors hover:border-foreground/25">
									<span class="flex flex-wrap items-center gap-1.5">
										{p.goals.map((goal) => <span class="badge badge-muted">{goalLabel(goal)}</span>)}
										{p.publisher === 'community' && <span class="badge badge-next">Community</span>}
									</span>
									<span class="font-medium leading-snug">{p.title}</span>
									<span class="text-sm text-muted-foreground">{p.summary}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
		<p data-empty hidden class="pt-14 text-sm text-muted-foreground">No playbook for that yet. <a href={contributeURL} class="font-medium text-foreground underline underline-offset-4">Write the first one</a>.</p>

		<section class="mt-16 grid gap-3 sm:grid-cols-3">
			<div class="card p-5">
				<h2 class="font-medium">Runs on your own accounts</h2>
				<p class="mt-1 text-sm text-muted-foreground">Every connection is yours: your email provider, your analytics, your AI key. A playbook whose connection is missing says what to connect and doesn't start.</p>
			</div>
			<div class="card p-5">
				<h2 class="font-medium">You approve before it acts</h2>
				<p class="mt-1 text-sm text-muted-foreground">Starting a playbook creates a mission draft. Anything that sends, posts or spends waits for your approval, and the contact rules and limits apply to every step.</p>
			</div>
			<div class="card p-5">
				<h2 class="font-medium">From any AI app</h2>
				<p class="mt-1 text-sm text-muted-foreground">With the <a href="/docs/agents/mcp/" class="underline underline-offset-4">Outflare MCP server</a> connected, your agent can list playbooks, read one and start it: <code>list_playbooks</code>, <code>get_playbook</code>, <code>start_playbook</code>.</p>
			</div>
		</section>

		<section class="card mt-6 flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
			<div>
				<h2 class="text-xl font-semibold tracking-tight">Have a playbook that works?</h2>
				<p class="mt-1 max-w-2xl text-sm text-muted-foreground">Playbooks are open source: one YAML file in the <code>playbooks/</code> folder of the Outflare repository. Recommend the tools and connectors you trust, send a pull request, and once it's reviewed it shows here and in every workspace with your GitHub handle on it.</p>
			</div>
			<div class="flex flex-wrap gap-3">
				<a href={contributeURL} class="btn btn-outline" data-track="playbook_contribute_click" data-track-label="footer_card">How to write one</a>
				<a href="/docs/agents/playbooks/" class="btn btn-ghost">Docs</a>
			</div>
		</section>
	</div>

	<script>
		const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
		const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
		const empty = document.querySelector<HTMLElement>('[data-empty]')!;
		for (const b of buttons) {
			b.addEventListener('click', () => {
				const goal = b.dataset.filter!;
				for (const o of buttons) o.setAttribute('aria-pressed', String(o === b));
				let shown = 0;
				for (const g of groups) {
					let inGroup = 0;
					for (const li of g.querySelectorAll<HTMLElement>('[data-item]')) {
						const hit = !goal || li.dataset.goals!.split(' ').includes(goal);
						li.hidden = !hit;
						if (hit) inGroup++;
					}
					g.hidden = inGroup === 0;
					shown += inGroup;
				}
				empty.hidden = shown > 0;
			});
		}
	</script>
</Marketing>
