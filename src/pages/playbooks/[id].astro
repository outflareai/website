---
import Marketing from '../../layouts/Marketing.astro';
import { app } from '../../data/project';
import { contributeURL, goalLabel, hasIntegrationPage, playbooks, tierLabel, type Playbook } from '../../data/playbooks';

export function getStaticPaths() {
	return playbooks.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: Playbook };
const related = playbooks.filter((o) => o.id !== p.id && o.goals.some((g) => p.goals.includes(g))).slice(0, 4);
const nothingNeeded = p.needs.data.length + p.needs.connections.length === 0;
---

<Marketing title={`${p.title} · Outflare playbook`} description={p.summary}>
	<section class="border-b">
		<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
			<nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
				<a href="/playbooks/" class="touch inline-flex items-center hover:text-foreground">Playbooks</a>
				<span aria-hidden="true" class="px-1.5">/</span>
				<a href={`/playbooks/#${p.tier}`} class="touch inline-flex items-center hover:text-foreground">{tierLabel(p.tier)}</a>
			</nav>
			<div class="mt-6 flex flex-wrap items-center gap-1.5">
				{p.goals.map((g) => <span class="badge badge-muted">{goalLabel(g)}</span>)}
				{p.publisher === 'community' ? <span class="badge badge-next">Community</span> : <span class="badge badge-live">By Outflare</span>}
			</div>
			<h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tighter text-balance sm:text-4xl">{p.title}</h1>
			<p class="sub mt-2">{p.summary}</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href="#prompt" class="btn btn-primary btn-lg">Get the prompt</a>
				<a href={app.signUp} class="btn btn-outline btn-lg">Run it in Outflare</a>
			</div>
		</div>
	</section>

	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1fr_18rem]">
		<div class="min-w-0 space-y-10">
			{
				p.description && (
					<section>
						<h2 class="text-xl font-semibold tracking-tight">Why it works</h2>
						<p class="mt-3 max-w-2xl whitespace-pre-line text-muted-foreground">{p.description}</p>
					</section>
				)
			}

			<section>
				<h2 class="text-xl font-semibold tracking-tight">Steps</h2>
				<ol class="mt-4 space-y-3 text-sm">
					{
						p.steps.map((s, i) => (
							<li class="flex gap-3">
								<span class="font-mono text-muted-foreground">{i + 1}</span>
								<span class="min-w-0">
									{s.say}
									{s.tools.length > 0 && <span class="mt-0.5 block font-mono text-xs break-words text-muted-foreground">{s.tools.join(', ')}</span>}
								</span>
							</li>
						))
					}
				</ol>
				<p class="mt-3 text-xs text-muted-foreground">The names under each step are the <a href="/docs/api/reference/" class="underline underline-offset-4">API operations</a> it uses. Each one is also an MCP tool.</p>
			</section>

			{
				p.guardrails.length > 0 && (
					<section>
						<h2 class="text-xl font-semibold tracking-tight">What it won't do</h2>
						<ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm">
							{p.guardrails.map((g) => <li>{g}</li>)}
						</ul>
					</section>
				)
			}

			<section>
				<h2 class="text-xl font-semibold tracking-tight">How you'll know it worked</h2>
				<ul class="mt-4 space-y-2 text-sm">
					{p.measure.map((m) => <li><span class="font-medium">{m.metric}.</span> <span class="text-muted-foreground">{m.how}</span></li>)}
				</ul>
			</section>

			<section id="prompt" class="scroll-mt-20">
				<div class="flex flex-wrap items-end justify-between gap-2">
					<h2 class="text-xl font-semibold tracking-tight">The prompt</h2>
					<button type="button" data-copy={p.prompt} data-track="playbook_prompt_copy" data-track-label={p.id} class="btn btn-outline btn-sm gap-1.5">
						<span data-icon="copy">Copy prompt</span>
						<span data-icon="done" class="hidden">Copied</span>
					</button>
				</div>
				<pre class="card mt-4 overflow-x-auto p-4 font-mono text-xs leading-relaxed whitespace-pre-wrap">{p.prompt}</pre>
				{
					p.inputs.length > 0 && (
						<div class="mt-4 text-sm">
							<p class="text-muted-foreground">Replace these before you run it:</p>
							<dl class="mt-2 space-y-1.5">
								{p.inputs.map((i) => (
									<div>
										<dt class="inline font-mono text-xs">{`{{${i.name}}}`}</dt>
										<dd class="inline text-muted-foreground">
											{' '}
											{i.label}
											{i.optional && ' (optional)'}
											{i.example && `, for example "${i.example}"`}
											{i.help && `. ${i.help}`}
										</dd>
									</div>
								))}
							</dl>
						</div>
					)
				}
				<p class="mt-4 text-sm text-muted-foreground">
					Paste it into Claude, ChatGPT or Cursor with the <a href="/docs/agents/mcp/" class="underline underline-offset-4">Outflare MCP server</a> connected. Or open <span class="text-foreground">Playbooks</span> in Outflare, fill in the blanks and start it as a mission: it waits for your approval before it changes anything. Agents can start it too, with <code>start_playbook</code> or <code>POST /v1/workspaces/&#123;ws&#125;/playbooks/{p.id}/runs</code>.
				</p>
			</section>

			{
				p.example && (
					<section>
						<h2 class="text-xl font-semibold tracking-tight">Example</h2>
						<p class="mt-3 max-w-2xl whitespace-pre-line text-muted-foreground">{p.example}</p>
					</section>
				)
			}

			{
				related.length > 0 && (
					<section>
						<h2 class="text-xl font-semibold tracking-tight">More playbooks like this</h2>
						<ul class="mt-4 grid gap-3 sm:grid-cols-2">
							{related.map((o) => (
								<li>
									<a href={`/playbooks/${o.id}/`} data-track="playbook_open" data-track-label={o.id} class="card block h-full p-4 transition-colors hover:border-foreground/25">
										<span class="block text-sm font-medium">{o.title}</span>
										<span class="mt-1 line-clamp-2 block text-sm text-muted-foreground">{o.summary}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</div>

		<aside class="h-fit space-y-4 text-sm">
			<div class="card divide-y">
				<div class="px-4 py-3">
					<h2 class="text-xs text-muted-foreground">What it needs</h2>
					<ul class="mt-2 space-y-2.5">
						{p.needs.data.map((d) => <li>{d.label}</li>)}
						{
							p.needs.connections.map((n) => (
								<li>
									{n.label}
									{n.optional && <span class="text-muted-foreground"> (optional)</span>}
									{n.recommended.length > 0 && (
										<span class="mt-0.5 block text-xs text-muted-foreground">
											Works with{' '}
											{n.recommended.map((id, i) => (
												<>
													{i > 0 && ', '}
													{hasIntegrationPage(id) ? <a href={`/integrations/${id}/`} class="underline underline-offset-4 hover:text-foreground">{n.recommended_names?.[i] ?? id}</a> : (n.recommended_names?.[i] ?? id)}
												</>
											))}
											{' '}or any tool that does the same.
										</span>
									)}
								</li>
							))
						}
						{nothingNeeded && <li class="text-muted-foreground">Nothing beyond Outflare itself.</li>}
					</ul>
					<p class="mt-3 text-xs text-muted-foreground">Every connection is your own account. Outflare never lends its keys.</p>
				</div>
				<dl class="divide-y">
					<div class="px-4 py-3"><dt class="text-xs text-muted-foreground">Kind</dt><dd class="mt-0.5 font-medium">{tierLabel(p.tier)}</dd></div>
					<div class="px-4 py-3">
						<dt class="text-xs text-muted-foreground">Written by</dt>
						<dd class="mt-0.5 font-medium">{p.publisher === 'community' ? <a href={`https://github.com/${p.author.github}`} rel="noopener" class="underline underline-offset-4">@{p.author.github}</a> : 'The Outflare team'}</dd>
					</div>
					<div class="px-4 py-3"><dt class="text-xs text-muted-foreground">Version</dt><dd class="mt-0.5 font-medium">{p.version}</dd></div>
				</dl>
				<div class="flex flex-col px-2 py-2">
					<a href={p.source_url} rel="noopener" data-track="playbook_source_click" data-track-label={p.id} class="touch inline-flex items-center rounded-md px-2 text-muted-foreground hover:text-foreground">View the source on GitHub ↗</a>
					<a href={contributeURL} rel="noopener" data-track="playbook_contribute_click" data-track-label="sidebar" class="touch inline-flex items-center rounded-md px-2 text-muted-foreground hover:text-foreground">Write your own ↗</a>
				</div>
			</div>
		</aside>
	</div>

	<script>
		document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
			b.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(b.dataset.copy ?? '');
				} catch {
					return;
				}
				const [copy, done] = ['copy', 'done'].map((n) => b.querySelector(`[data-icon=${n}]`));
				copy?.classList.add('hidden');
				done?.classList.remove('hidden');
				setTimeout(() => {
					copy?.classList.remove('hidden');
					done?.classList.add('hidden');
				}, 1600);
			}),
		);
	</script>
</Marketing>
