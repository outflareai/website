---
import Marketing from '../../layouts/Marketing.astro';
import Line from '../../components/ChangelogLine.astro';
import { app, repo } from '../../data/project';
import { areas, days, releases, selfHostedFor, type Day, type Item } from '../../data/changelog';

const latestRelease = releases.at(-1);
const time = (iso?: string) => (iso ? `${iso.slice(11, 16)} UTC` : '');
const longDate = (date: string) =>
	new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// Launches lead as highlights; improvements are grouped by area; fixes and security
// lines are folded away so a busy day stays readable.
function sections(day: Day) {
	const byArea = (items: Item[]) =>
		Object.keys(areas)
			.map((id) => ({ id, label: areas[id], items: items.filter((i) => i.area === id) }))
			.filter((g) => g.items.length);
	return {
		highlights: day.items.filter((i) => i.kind === 'launch'),
		improved: byArea(day.items.filter((i) => i.kind === 'improvement')),
		fixed: day.items.filter((i) => i.kind === 'fix' || i.kind === 'security'),
	};
}
---

<Marketing title="Changelog · Outflare" description="What changed in Outflare each day, on Outflare Cloud and in the open-source engine you can self-host.">
	<link slot="head" rel="alternate" type="application/rss+xml" title="Outflare changelog" href="/changelog.xml" />
	<section class="relative border-b">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
			<p class="eyebrow">Changelog</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tighter text-balance sm:text-5xl">What changed, every day</h1>
			<p class="sub">
				Each day that Outflare Cloud gets an update has an entry, named by its date in UTC. It fills up as the day's updates go live and is final at midnight UTC.{' '}
				<span class="badge badge-live align-middle">Open source</span> changes are in the engine, so they run on Cloud that day and in your own install from the next self-hosted release.{' '}
				<span class="badge badge-next align-middle">Cloud</span> changes are only on app.outflare.ai.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<div class="flex gap-1.5" role="group" aria-label="Show changes">
					<button type="button" class="btn btn-sm btn-ghost aria-pressed:bg-accent aria-pressed:text-foreground" data-edition="" aria-pressed="true" data-track="changelog_filter" data-track-label="all">All</button>
					<button type="button" class="btn btn-sm btn-ghost aria-pressed:bg-accent aria-pressed:text-foreground" data-edition="open-source" aria-pressed="false" data-track="changelog_filter" data-track-label="open-source">Open source</button>
					<button type="button" class="btn btn-sm btn-ghost aria-pressed:bg-accent aria-pressed:text-foreground" data-edition="cloud" aria-pressed="false" data-track="changelog_filter" data-track-label="cloud">Cloud</button>
				</div>
				<a href="/changelog.xml" class="btn btn-sm btn-outline" data-track="changelog_rss">RSS</a>
				<a href={`${repo.website}/tree/main/changelog`} class="btn btn-sm btn-outline">On GitHub</a>
				{latestRelease && <a href={`${repo.url}/releases/tag/${latestRelease.version}`} class="btn btn-sm btn-outline">Latest self-hosted release: {latestRelease.version}</a>}
			</div>
		</div>
	</section>

	<div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
		{days.length === 0 && <p class="pt-14 text-muted-foreground">The first entry appears after the next update to Outflare Cloud.</p>}
		{
			days.map((day) => {
				const s = sections(day);
				const selfHosted = selfHostedFor(day);
				const hasOpen = day.items.some((i) => i.edition === 'open-source');
				return (
					<article id={day.date} class="grid scroll-mt-20 gap-6 border-b py-12 md:grid-cols-[13rem_1fr]" data-day>
						<header class="md:sticky md:top-20 md:self-start">
							<h2 class="font-mono text-lg font-semibold">
								<a href={`#${day.date}`} class="hover:underline">{day.version}</a>
							</h2>
							<p class="mt-1 text-sm text-muted-foreground">{longDate(day.date)}</p>
							<p class="mt-3">
								{day.status === 'final' ? <span class="badge badge-muted">Final</span> : <span class="badge badge-next">In progress · updated {time(day.updated)}</span>}
							</p>
							{hasOpen && <p class="mt-3 text-xs text-muted-foreground">Self-hosted: {selfHosted ? <a class="underline hover:text-foreground" href={`${repo.url}/releases/tag/${selfHosted}`}>{selfHosted}</a> : 'in the next release'}</p>}
						</header>
						<div class="min-w-0 space-y-8">
							{s.highlights.length > 0 && (
								<section>
									<h3 class="eyebrow">New</h3>
									<ul class="mt-3 space-y-3">{s.highlights.map((i) => <Line item={i} big />)}</ul>
								</section>
							)}
							{s.improved.length > 0 && (
								<section>
									<h3 class="eyebrow">Improved</h3>
									<div class="mt-3 space-y-4">
										{s.improved.map((g) => (
											<div>
												<h4 class="text-sm font-medium">{g.label}</h4>
												<ul class="mt-1.5 space-y-2">{g.items.map((i) => <Line item={i} />)}</ul>
											</div>
										))}
									</div>
								</section>
							)}
							{s.fixed.length > 0 && (
								<details class="group">
									<summary class="eyebrow cursor-pointer list-none hover:text-foreground">Fixes and security ({s.fixed.length}) <span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span></summary>
									<ul class="mt-3 space-y-2">{s.fixed.map((i) => <Line item={i} />)}</ul>
								</details>
							)}
						</div>
					</article>
				);
			})
		}
		<p class="pt-10 text-sm text-muted-foreground">
			Self-hosting? Each release's notes, with any upgrade steps, are in <a class="underline hover:text-foreground" href={`${repo.url}/blob/main/CHANGELOG.md`}>CHANGELOG.md</a>. Using Outflare Cloud? Everything here is already live at <a class="underline hover:text-foreground" href={app.url}>app.outflare.ai</a>.
		</p>
	</div>
</Marketing>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-edition]');
	buttons.forEach((b) =>
		b.addEventListener('click', () => {
			const want = b.dataset.edition;
			buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
			document.querySelectorAll<HTMLElement>('[data-line]').forEach((li) => (li.hidden = !!want && li.dataset.line !== want));
			document.querySelectorAll<HTMLElement>('[data-day]').forEach((d) => (d.hidden = !d.querySelector('[data-line]:not([hidden])')));
		}),
	);
</script>

