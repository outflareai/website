---
import Marketing from '../layouts/Marketing.astro';
import { site } from '../data/project';
import social from '../data/social.json';

// Brand icons (Simple Icons, CC0). A profile without one shows its first letter.
const icons: Record<string, { viewBox: string; d: string }> = {
	x: { viewBox: '0 0 24 24', d: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z' },
	github: { viewBox: '0 0 16 16', d: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z' },
	npm: { viewBox: '0 0 24 24', d: 'M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z' },
};
---

<Marketing title="Social · Outflare" description="Every official Outflare profile in one place: X, GitHub, npm and more. If a profile isn't listed here, it isn't ours.">
	<section class="relative border-b">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
			<p class="eyebrow">Social</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tighter text-balance sm:text-5xl">Follow Outflare</h1>
			<p class="sub">Every official Outflare profile, in one place. If a profile isn't listed here, it isn't ours.</p>
		</div>
	</section>

	<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
		<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{
				social.profiles.map((p) => (
					<li>
						<a href={p.url} rel="me noopener" data-track="social_profile_click" data-track-label={p.id} class="card group flex h-full items-start gap-3.5 p-4 transition-colors hover:border-foreground/25">
							<span class="flex size-11 shrink-0 items-center justify-center rounded-lg border bg-background text-foreground">
								{icons[p.id] ? (
									<svg viewBox={icons[p.id].viewBox} class="size-5" aria-hidden="true"><path fill="currentColor" d={icons[p.id].d} /></svg>
								) : (
									<span class="font-semibold" aria-hidden="true">{p.name[0]}</span>
								)}
							</span>
							<span class="min-w-0">
								<span class="flex flex-wrap items-baseline gap-x-2">
									<span class="font-medium">{p.name}</span>
									<span class="text-sm text-muted-foreground">{p.handle}</span>
								</span>
								<span class="mt-1 block text-sm text-muted-foreground">{p.about}</span>
								<span class="mt-2 block font-mono text-xs text-muted-foreground">outflare.ai/{p.short}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<p class="mt-8 text-sm text-muted-foreground">More profiles appear here as we open them. Something else claiming to be Outflare? Tell us at <a href={`mailto:${site.email}`} class="underline underline-offset-4 hover:text-foreground">{site.email}</a>.</p>
	</div>
</Marketing>
