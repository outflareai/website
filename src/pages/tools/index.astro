---
import Marketing from '../../layouts/Marketing.astro';

const tools = [
	{ href: '/tools/dmarc-checker/', name: 'SPF, DKIM and DMARC checker', body: 'Test your domain’s email authentication and MX, and get the exact DNS record to add for each problem.' },
	{ href: '/tools/blacklist-checker/', name: 'Domain blacklist checker', body: 'See whether your domain is on the Spamhaus DBL or SURBL, and how to get removed.' },
];
---

<Marketing title="Free email and marketing tools · Outflare" description="Free tools from Outflare: check your domain's SPF, DKIM and DMARC, and whether it's on an email blacklist. No sign-up needed." crumbs={[{ name: 'Free tools', path: '/tools/' }]}>
	<section class="relative border-b">
		<div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
			<p class="eyebrow">Free tools</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tighter text-balance sm:text-5xl">Free tools, no sign-up.</h1>
			<p class="sub">Quick checks from the same engine Outflare uses to keep sending domains healthy.</p>
		</div>
	</section>
	<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
		<ul class="grid gap-4 sm:grid-cols-2">
			{tools.map((t) => (
				<li class="card relative p-6 transition-colors has-[a:hover]:border-foreground/20">
					<a href={t.href} class="font-medium after:absolute after:inset-0">{t.name}</a>
					<p class="mt-2 text-sm text-muted-foreground">{t.body}</p>
				</li>
			))}
		</ul>
	</div>
</Marketing>
