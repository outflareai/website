---
// A connector's logo, with the company's light-on-dark variant in the dark theme.
import { darkLogo, logo, type Integration } from '../data/integrations';

interface Props {
	integration: Integration;
	size?: number;
	class?: string;
}
const { integration: i, size = 32, class: cls } = Astro.props;
---

{
	i.dark_logo ? (
		<>
			<img src={logo(i)} alt="" width={size} height={size} class:list={['shrink-0 dark:hidden', cls]} loading="lazy" decoding="async" />
			<img src={darkLogo(i)} alt="" width={size} height={size} class:list={['hidden shrink-0 dark:block', cls]} loading="lazy" decoding="async" />
		</>
	) : (
		<img src={logo(i)} alt="" width={size} height={size} class:list={['shrink-0', cls]} loading="lazy" decoding="async" />
	)
}
