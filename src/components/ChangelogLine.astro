---
// One line of a changelog day: its edition tag, the text, thanks and the time it went live.
// No pull request links: Outflare is built in private repositories and published by release.
import { editions, type Item } from '../data/changelog';

interface Props {
	item: Item;
	big?: boolean;
}
const { item, big } = Astro.props;
---

<li data-line={item.edition} class:list={['flex gap-3', big ? 'text-base' : 'text-sm text-muted-foreground']}>
	<span class:list={['badge h-fit shrink-0', item.edition === 'cloud' ? 'badge-next' : 'badge-live']}>{editions[item.edition]}</span>
	<span class="min-w-0">
		<span class={big ? 'text-foreground' : ''}>{item.text}</span>
		{item.kind === 'security' && <span class="badge badge-muted ml-1">Security</span>}
		{item.thanks?.length ? <span class="ml-1.5 text-xs">Thanks {item.thanks.map((h, i) => <>{i > 0 && ', '}<a href={`https://github.com/${h}`} class="underline hover:text-foreground">@{h}</a></>)}</span> : null}
		{item.at && <span class="ml-1.5 font-mono text-xs text-muted-foreground/70">{item.at.slice(11, 16)} UTC</span>}
	</span>
</li>
