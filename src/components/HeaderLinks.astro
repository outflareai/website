---
// The docs header's right side: the same links as the home page nav, then
// GitHub and Sign in (Dashboard when signed in, see SignedIn.astro). Replaces Starlight's SocialIcons.
import { app } from '../data/project';
import GitHubButton from './GitHubButton.astro';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/integrations/', label: 'Integrations' },
	{ href: '/docs/api/', label: 'API' },
	{ href: '/docs/agents/mcp/', label: 'MCP' },
	{ href: '/docs/project/roadmap/', label: 'Roadmap' },
];
const here = Astro.url.pathname;
---

<nav class="header-links" aria-label="Site">
	{links.map((l) => <a href={l.href} aria-current={l.href !== '/' && here.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
</nav>
<GitHubButton class="gh" />
<a class="signin" href={app.signIn} data-signed-out>Sign in</a>
<a class="signin" href={app.url} data-signed-in data-track="dashboard_click">Dashboard</a>

<style>
	.header-links { display: flex; gap: 0.25rem; }
	.header-links a {
		padding: 0.375rem 0.625rem;
		border-radius: var(--radius-md);
		font-size: 0.875rem;
		color: var(--muted-foreground);
		text-decoration: none;
		transition: color 0.15s;
	}
	.header-links a:hover, .header-links a[aria-current='page'] { color: var(--foreground); }
	.header-links ~ :global(.gh) {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		height: 2rem;
		padding: 0 0.75rem;
		border: 1px solid var(--input);
		border-radius: var(--radius-md);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--foreground);
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.header-links ~ :global(.gh):hover { background: var(--accent); }
	.signin {
		display: inline-flex;
		align-items: center;
		height: 2rem;
		padding: 0 0.75rem;
		border-radius: var(--radius-md);
		background: var(--primary);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--primary-foreground);
		text-decoration: none;
		white-space: nowrap;
		transition: opacity 0.15s;
	}
	.signin:hover { opacity: 0.9; }
	@media (max-width: 639px), (pointer: coarse) { .header-links ~ :global(.gh), .signin { min-height: 2.75rem; } }
	@media (max-width: 64rem) { .header-links { display: none; } }
</style>
