---
// A link to the engine's GitHub repository with its star count, as a trust
// signal. The count shows once the repository is public and has a star;
// until then it is a plain "GitHub" link. The number comes from the build,
// then from /github-stars (functions/github-stars.js), so it stays fresh.
// Clicks are github_click events like every other GitHub link.
import { repo } from '../data/project';
import { formatStars, stars } from '../data/stars';

interface Props {
	class?: string;
	// compact: text only, for the phone nav row.
	compact?: boolean;
}
const { class: className = '', compact = false } = Astro.props;
const shown = stars !== null && stars > 0;
---

<a href={repo.url} class:list={['gh-stars', className]} data-gh-stars aria-label={shown ? `Outflare on GitHub, ${stars} stars` : 'Outflare on GitHub'}>
	{!compact && (
		<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
	)}
	<span>GitHub</span>
	<span class="gh-count" data-gh-count hidden={!shown} aria-hidden="true">
		<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path></svg>
		<span data-gh-number>{shown ? formatStars(stars) : ''}</span>
	</span>
</a>

<script>
	import { formatStars } from '../data/format-stars';
	import { repo } from '../data/project';

	// One lookup per visitor an hour, however many buttons and pages: the
	// last count is kept in localStorage. /github-stars (cached at the edge)
	// comes first; if it has no count, the browser asks GitHub itself, with no
	// token. Any failure keeps the count from the build.
	const buttons = document.querySelectorAll<HTMLAnchorElement>('[data-gh-stars]');
	const storeKey = 'outflare:github-stars';
	const maxAge = 3600 * 1000;

	function show(n: number) {
		for (const b of buttons) {
			const count = b.querySelector<HTMLElement>('[data-gh-count]');
			const num = b.querySelector<HTMLElement>('[data-gh-number]');
			if (!count || !num) continue;
			num.textContent = formatStars(n);
			count.hidden = false;
			b.setAttribute('aria-label', `Outflare on GitHub, ${n} stars`);
		}
	}

	function remembered(): number | null {
		try {
			const v = JSON.parse(localStorage.getItem(storeKey) || 'null');
			return v && typeof v.n === 'number' && Date.now() - v.at < maxAge ? v.n : null;
		} catch {
			return null;
		}
	}

	function remember(n: number) {
		try {
			localStorage.setItem(storeKey, JSON.stringify({ n, at: Date.now() }));
		} catch {
			// Private windows and blocked storage just look it up again.
		}
	}

	async function edge(): Promise<number | null> {
		const r = await fetch('/github-stars');
		if (!r.ok) return null;
		const d: { stars: number | null } = await r.json();
		return typeof d.stars === 'number' ? d.stars : null;
	}

	async function github(): Promise<number | null> {
		const r = await fetch(`https://api.github.com/repos/${repo.owner}/${repo.name}`, {
			headers: { accept: 'application/vnd.github+json' },
		});
		if (!r.ok) return null;
		const d = await r.json();
		return d.private === false && Number.isInteger(d.stargazers_count) ? d.stargazers_count : null;
	}

	if (buttons.length) {
		const known = remembered();
		if (known !== null) {
			if (known > 0) show(known);
		} else {
			edge()
				.catch(() => null)
				.then((n) => (n === null ? github().catch(() => null) : n))
				.then((n) => {
					if (n === null) return;
					remember(n);
					if (n > 0) show(n);
				});
		}
	}
</script>

<style>
	.gh-stars { white-space: nowrap; }
	.gh-count {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-left: 0.125rem;
		padding-left: 0.5rem;
		border-left: 1px solid currentColor;
		border-left-color: color-mix(in oklab, currentColor 25%, transparent);
		font-variant-numeric: tabular-nums;
	}
	.gh-count[hidden] { display: none; }
</style>
